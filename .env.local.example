# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — it must never be committed.

# ---------- Supabase ----------
# Found at: https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS. Never expose to the browser.
# Used by isolated server endpoints (e.g. ADR 0001 — public profile).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- GitHub OAuth ----------
# These are set in the Supabase dashboard, not in this file —
# but you need them to know what to paste when configuring the provider.
# https://github.com/settings/developers → "New OAuth App"
# Authorization callback URL must be:
#   https://<project>.supabase.co/auth/v1/callback
# Client ID + Secret go into Supabase → Authentication → Providers → GitHub.

# ---------- GitHub API (optional) ----------
# Fine-grained personal token with no scopes (public data only). Raises the
# events API limit from 60 req/h per IP to 5000 req/h. Leave empty locally;
# set in Vercel once the cron iterates more than a handful of users.
GITHUB_TOKEN=

# ---------- Vercel Cron ----------
# Shared secret for /api/cron/sync. Generate once with `openssl rand -hex 32`
# and mirror in Vercel project env vars (Settings → Environment Variables).
# Vercel injects `Authorization: Bearer ${CRON_SECRET}` automatically on
# every cron invocation; the route 401s otherwise.
CRON_SECRET=

# ---------- Sentry ----------
# DSN is safe to expose to the client (POST-only access to event ingestion).
# Both vars get the same value — Next.js inlines NEXT_PUBLIC_* at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Used by withSentryConfig in next.config.ts to upload sourcemaps at build.
# Personal token from https://<org>.sentry.io/settings/account/api/auth-tokens/
# Scopes: project:read + project:releases (or Project: Read & Write + Release: Admin).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
